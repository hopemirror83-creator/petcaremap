---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import SimpleMap from '../../components/SimpleMap.astro';
import AdSlot from '../../components/AdSlot.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import { areaGroups, longtailGroups, typeGroups } from '../../data/siteData';

export function getStaticPaths() {
  return longtailGroups.map((group: any) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const title = group.title;
const description = `${group.description} 후기, 운영시간, 예약, 주차, 전화 확인사항을 함께 정리했습니다.`;
const relatedAreas = areaGroups.slice(0, 6);
const relatedTypes = typeGroups.slice(0, 6);
const items = group.items || [];
const sourceCount = items.filter((item: any) => Number(item.sourceCount || 0) > 0).length;
const naverReviewCount = items.reduce((sum: number, item: any) => sum + Number(item.naverMapReviewCount || 0), 0);
const withPhoneCount = items.filter((item: any) => item.phone).length;
const withMapCount = items.filter((item: any) => item.naverMapUrl || item.lat || item.lng || item.mapx || item.mapy).length;
const topItems = [...items].sort((a: any, b: any) => Number(b.rankScore || 0) - Number(a.rankScore || 0)).slice(0, 5);
const faqItems = [
  {
    question: `${group.name}은 실제로 모두 24시 또는 야간진료가 가능한가요?`,
    answer: '페이지에는 공개 정보와 후기 후보에서 관련 단서가 확인되는 병원이 포함됩니다. 실제 야간 접수, 응급 대응, 담당 진료진 여부는 날짜와 시간에 따라 달라질 수 있어 이동 전 전화 확인이 필요합니다.'
  },
  {
    question: '특수동물, 거북이, 햄스터 진료는 어떻게 확인해야 하나요?',
    answer: '동물 종류, 나이, 증상, 사육 환경을 구체적으로 말하고 가능 여부를 확인하는 편이 좋습니다. 같은 특수동물이라도 병원별로 가능한 진료 범위가 다를 수 있습니다.'
  },
  {
    question: '후기 많은 병원이 항상 더 좋은 병원인가요?',
    answer: '후기 수는 공개 자료의 양을 보여주는 참고 지표입니다. 후기가 많다고 진료 결과를 보장하는 것은 아니며, 후기 내용과 위치, 전화 연결, 원하는 진료 가능 여부를 함께 비교하는 것이 좋습니다.'
  },
  {
    question: '응급 상황이면 이 목록만 보고 이동해도 되나요?',
    answer: '응급 상황에서는 가까운 병원이라도 바로 접수가 어려울 수 있습니다. 전화 연결 여부, 현재 접수 가능 여부, 예상 도착 시간을 먼저 확인한 뒤 이동하는 편이 안전합니다.'
  }
];
---

<BaseLayout title={title} description={description}>
  <section class="page-head">
    <p class="eyebrow">롱테일 묶음</p>
    <h1>{group.title}</h1>
    <p>{description}</p>
    <div class="tag-row service-tags">
      <span>{items.length.toLocaleString('ko-KR')}곳 정리</span>
      <span>후기 기반</span>
      <span>방문 전 확인 중심</span>
    </div>
  </section>

  <AdSlot position="top" />

  <section class="decision-section section-tint">
    <div class="section-heading">
      <span>요약</span>
      <h2>이 묶음에서 먼저 볼 기준</h2>
      <p>후기 자료, 지도, 전화번호처럼 방문 전에 실제로 비교하게 되는 항목을 먼저 정리했습니다.</p>
    </div>
    <div class="rating-grid">
      <div class="rating-item">
        <span>전체 후보</span>
        <strong>{items.length.toLocaleString('ko-KR')}곳</strong>
      </div>
      <div class="rating-item">
        <span>블로그·카페 후기 확인</span>
        <strong>{sourceCount.toLocaleString('ko-KR')}곳</strong>
      </div>
      <div class="rating-item">
        <span>네이버 지도 리뷰</span>
        <strong>{naverReviewCount.toLocaleString('ko-KR')}개</strong>
      </div>
      <div class="rating-item">
        <span>전화번호 확인</span>
        <strong>{withPhoneCount.toLocaleString('ko-KR')}곳</strong>
      </div>
      <div class="rating-item">
        <span>지도 위치 확인</span>
        <strong>{withMapCount.toLocaleString('ko-KR')}곳</strong>
      </div>
    </div>
  </section>

  <section class="decision-section prose-section">
    <article>
      <h2>선택 기준</h2>
      {(group.body || []).map((paragraph: string) => <p>{paragraph}</p>)}
    </article>
  </section>

  <section class="decision-section">
    <div class="section-heading">
      <span>지도</span>
      <h2>{group.name} 위치 비교</h2>
      <p>이 검색 주제에 포함된 동물병원의 위치를 한 번에 확인할 수 있습니다.</p>
    </div>
    <SimpleMap items={group.items} title={group.name} />
  </section>

  <InArticleAd />

  <section class="decision-section section-tint">
    <div class="section-heading">
      <span>목록</span>
      <h2>{items.length.toLocaleString('ko-KR')}곳</h2>
      <p>네이버 장소 매칭, 전화번호, 주소, 후기가 확인된 병원만 테스트 목록에 포함했습니다.</p>
    </div>
    <div class="business-grid">
      {items.map((item: any) => <BusinessCard item={item} />)}
    </div>
  </section>

  <section class="decision-section">
    <div class="section-heading">
      <span>비교</span>
      <h2>먼저 비교해볼 병원</h2>
      <p>후기 후보, 지도 리뷰, 전화번호, 위치 정보를 함께 볼 때 우선 확인하기 좋은 병원입니다.</p>
    </div>
    <div class="comparison-wrap">
      <table>
        <thead>
          <tr>
            <th>병원</th>
            <th>지역</th>
            <th>후기 자료</th>
            <th>네이버 리뷰</th>
            <th>전화</th>
          </tr>
        </thead>
        <tbody>
          {topItems.map((item: any) => (
            <tr>
              <td><a href={`/${item.typePath}/${item.slug}/`}>{item.name}</a></td>
              <td>{[item.district, item.dong].filter(Boolean).join(' ')}</td>
              <td>{item.reviewCoverageLabel || '확인 필요'}</td>
              <td>{Number(item.naverMapReviewCount || 0).toLocaleString('ko-KR')}개</td>
              <td>{item.phone || '개별 확인'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="decision-section">
    <div class="section-heading">
      <span>FAQ</span>
      <h2>{group.name} 자주 묻는 질문</h2>
    </div>
    <div class="faq-list">
      {faqItems.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="decision-section">
    <div class="section-heading">
      <span>내부링크</span>
      <h2>관련 지역과 진료유형</h2>
    </div>
    <div class="topic-grid">
      {relatedAreas.map((area: any) => (
        <a class="topic-card" href={`/area/${area.slug}/`}>
          <strong>{area.name}</strong>
          <span>{area.items.length.toLocaleString('ko-KR')}곳</span>
        </a>
      ))}
      {relatedTypes.map((type: any) => (
        <a class="topic-card" href={`/type/${type.slug}/`}>
          <strong>{type.name}</strong>
          <span>{type.items.length.toLocaleString('ko-KR')}곳</span>
        </a>
      ))}
    </div>
  </section>

  <AdSlot position="bottom" />
</BaseLayout>
